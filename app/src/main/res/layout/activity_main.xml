<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:overScrollMode="never"
    tools:context=".MainActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="24dp"
        android:paddingTop="32dp"
        android:paddingEnd="24dp"
        android:paddingBottom="32dp">

        <ImageView
            android:id="@+id/imgUsuario"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:contentDescription="@string/descripcion_icono_usuario"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/account_circle"
            app:tint="?attr/colorPrimary" />

        <TextView
            android:id="@+id/tvTitulo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="@string/titulo_registro"
            android:textAppearance="@style/TextAppearance.Material3.HeadlineMedium"
            android:textColor="?attr/colorPrimary"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/imgUsuario" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilNombres"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:hint="@string/hint_nombres"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTitulo"
            app:startIconDrawable="@drawable/person"
            app:startIconTint="?attr/colorPrimary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etNombres"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="personGivenName"
                android:inputType="textCapWords|textPersonName"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilApellidos"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/hint_apellidos"
            app:layout_constraintEnd_toEndOf="@id/tilNombres"
            app:layout_constraintStart_toStartOf="@id/tilNombres"
            app:layout_constraintTop_toBottomOf="@id/tilNombres"
            app:startIconDrawable="@drawable/person"
            app:startIconTint="?attr/colorPrimary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etApellidos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="personFamilyName"
                android:inputType="textCapWords|textPersonName"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilTipoDocumento"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/hint_tipo_documento"
            app:layout_constraintEnd_toEndOf="@id/tilNombres"
            app:layout_constraintStart_toStartOf="@id/tilNombres"
            app:layout_constraintTop_toBottomOf="@id/tilApellidos"
            app:startIconDrawable="@drawable/id_card"
            app:startIconTint="?attr/colorPrimary">

            <AutoCompleteTextView
                android:id="@+id/actTipoDocumento"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:maxLines="1"
                app:simpleItems="@array/tipos_documento"
                tools:ignore="LabelFor" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilIdentificacion"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/hint_identificacion"
            app:layout_constraintEnd_toEndOf="@id/tilNombres"
            app:layout_constraintStart_toStartOf="@id/tilNombres"
            app:layout_constraintTop_toBottomOf="@id/tilTipoDocumento"
            app:startIconDrawable="@drawable/id_card"
            app:startIconTint="?attr/colorPrimary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etIdentificacion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:maxLength="13"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/tvGenero"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:drawablePadding="8dp"
            android:gravity="center_vertical"
            app:drawableStartCompat="@drawable/wc"
            app:drawableTint="?attr/colorPrimary"
            android:text="@string/seccion_genero"
            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="@id/tilNombres"
            app:layout_constraintStart_toStartOf="@id/tilNombres"
            app:layout_constraintTop_toBottomOf="@id/tilIdentificacion" />

        <RadioGroup
            android:id="@+id/rgGenero"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="@id/tilNombres"
            app:layout_constraintStart_toStartOf="@id/tilNombres"
            app:layout_constraintTop_toBottomOf="@id/tvGenero">

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/rbHombre"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:drawableStart="@drawable/man"
                android:drawablePadding="4dp"
                android:drawableTint="@color/color_hombre"
                android:minWidth="0dp"
                android:paddingStart="0dp"
                android:paddingEnd="4dp"
                android:text="@string/genero_hombre"
                android:textSize="14sp"
                android:buttonTint="?attr/colorPrimary" />

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/rbMujer"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:drawableStart="@drawable/woman"
                android:drawablePadding="4dp"
                android:drawableTint="@color/color_mujer"
                android:minWidth="0dp"
                android:paddingStart="0dp"
                android:paddingEnd="4dp"
                android:text="@string/genero_mujer"
                android:textSize="14sp"
                android:buttonTint="?attr/colorPrimary" />

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/rbOtro"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:minWidth="0dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:text="@string/genero_otro"
                android:textSize="14sp"
                android:buttonTint="?attr/colorPrimary" />
        </RadioGroup>

        <TextView
            android:id="@+id/tvFechaNacimiento"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:drawablePadding="8dp"
            android:gravity="center_vertical"
            app:drawableStartCompat="@drawable/calendar_month"
            app:drawableTint="?attr/colorPrimary"
            android:text="@string/seccion_fecha_nacimiento"
            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="@id/tilNombres"
            app:layout_constraintStart_toStartOf="@id/tilNombres"
            app:layout_constraintTop_toBottomOf="@id/rgGenero" />

        <LinearLayout
            android:id="@+id/llFechaNacimiento"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:baselineAligned="false"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="@id/tilNombres"
            app:layout_constraintStart_toStartOf="@id/tilNombres"
            app:layout_constraintTop_toBottomOf="@id/tvFechaNacimiento">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilDia"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/hint_dia">

                <AutoCompleteTextView
                    android:id="@+id/actDia"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:maxLines="1"
                    app:simpleItems="@array/dias"
                    tools:ignore="LabelFor" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilMes"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1.4"
                android:hint="@string/hint_mes">

                <AutoCompleteTextView
                    android:id="@+id/actMes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:maxLines="1"
                    app:simpleItems="@array/meses"
                    tools:ignore="LabelFor" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilAnio"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:hint="@string/hint_anio">

                <AutoCompleteTextView
                    android:id="@+id/actAnio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:maxLines="1"
                    app:simpleItems="@array/anios"
                    tools:ignore="LabelFor" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilTelefono"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/hint_telefono"
            app:layout_constraintEnd_toEndOf="@id/tilNombres"
            app:layout_constraintStart_toStartOf="@id/tilNombres"
            app:layout_constraintTop_toBottomOf="@id/llFechaNacimiento"
            app:startIconDrawable="@drawable/phone"
            app:startIconTint="?attr/colorPrimary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etTelefono"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="phone"
                android:inputType="phone"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGrabar"
            style="@style/Widget.Material3.Button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:minHeight="56dp"
            android:text="@string/accion_grabar"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="14dp"
            app:icon="@drawable/save"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:iconTint="?attr/colorOnPrimary"
            app:layout_constraintEnd_toEndOf="@id/tilNombres"
            app:layout_constraintStart_toStartOf="@id/tilNombres"
            app:layout_constraintTop_toBottomOf="@id/tilTelefono" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
